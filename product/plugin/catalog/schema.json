{
  "$id": "https://agentlinux.org/schemas/catalog.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentLinux Catalog",
  "description": "Catalog of available agents. Each entry is opt-in (CAT-02). Stability-first pinning (ADR-011): every entry carries a required pinned_version.",
  "type": "object",
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "$comment": "GENERATED from rust/crates/agentlinux-core/src/schema_gen.rs (TEST-03). Do not hand-edit — regenerate with `UPDATE_SCHEMA=1 cargo test -p agentlinux-core schema` and commit.",
  "additionalProperties": false,
  "required": [
    "version",
    "agents"
  ],
  "$defs": {
    "agent": {
      "type": "object",
      "properties": {
        "compatibility_window": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https://"
        },
        "homepage": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "install_recipe_path": {
          "type": "string",
          "pattern": "^[a-z0-9_./-]+\\.sh$"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "npm_package_name": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(@[a-z0-9-]+/)?[a-z0-9][a-z0-9_-]*$"
        },
        "pinned_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "post_install_verify": {
          "type": [
            "string",
            "null"
          ]
        },
        "preserve_paths_file": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9_./-]+\\.json$"
        },
        "requires_secret": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rewire_recipe_path": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9_./-]+\\.sh$"
        },
        "secret_env": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "npm",
            "script",
            "binary",
            "mcp"
          ]
        },
        "tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "test_only": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "uninstall_recipe_path": {
          "type": "string",
          "pattern": "^[a-z0-9_./-]+\\.sh$"
        },
        "version_constraint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "npm"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "required": [
              "npm_package_name"
            ]
          }
        }
      ],
      "required": [
        "id",
        "display_name",
        "description",
        "source_kind",
        "pinned_version",
        "install_recipe_path",
        "uninstall_recipe_path"
      ]
    }
  }
}
